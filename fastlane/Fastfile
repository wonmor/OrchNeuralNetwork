default_platform(:ios)

APP_ID   = "com.johnseong.OrchNeuralNetwork"
USERNAME = "wonmor@yahoo.com"
TEAM_ID  = "Z64KRUX3W3"

def connect_login
  Spaceship::ConnectAPI.login(USERNAME, nil, use_portal: false, use_tunes: true, tunes_team_id: TEAM_ID)
end

def edit_version
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App #{APP_ID} not found on App Store Connect") unless app
  v = app.get_edit_app_store_version
  UI.user_error!("No editable version") unless v
  [app, v]
end

platform :ios do
  desc "Set the age rating questionnaire to all-None (4+), including the 2025 questions fastlane's deliver does not know"
  lane :age_rating do
    connect_login
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    info = app.fetch_edit_app_info || app.fetch_live_app_info
    decl = info.fetch_age_rating_declaration
    attrs = {
      alcoholTobaccoOrDrugUseOrReferences: "NONE", contests: "NONE", gamblingSimulated: "NONE",
      medicalOrTreatmentInformation: "NONE", profanityOrCrudeHumor: "NONE",
      sexualContentGraphicAndNudity: "NONE", sexualContentOrNudity: "NONE",
      horrorOrFearThemes: "NONE", matureOrSuggestiveThemes: "NONE",
      violenceCartoonOrFantasy: "NONE", violenceRealistic: "NONE",
      violenceRealisticProlongedGraphicOrSadistic: "NONE", gunsOrOtherWeapons: "NONE",
      unrestrictedWebAccess: false, gambling: false, lootBox: false, advertising: false,
      ageAssurance: false, healthOrWellnessTopics: false, messagingAndChat: false,
      parentalControls: false, userGeneratedContent: false
    }
    Spaceship::ConnectAPI.patch_age_rating_declaration(age_rating_declaration_id: decl.id, attributes: attrs)
    UI.success("Age rating declaration updated (#{decl.id})")
  end

  desc "Declare 'Data Not Collected' in the App Privacy section"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      username: USERNAME, team_id: TEAM_ID, app_identifier: APP_ID,
      json_path: "fastlane/app_data_usages.json"
    )
  end

  desc "Show build processing and version state"
  lane :status do
    connect_login
    app, v = edit_version
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 3).each do |b|
      UI.message("build #{b.version} for #{b.app_version}: #{b.processing_state}")
    end
    UI.message("version #{v.version_string}: #{v.app_store_state}")
  end

  desc "Submit version 1.0 for review using the latest processed build"
  lane :submit do
    deliver(
      username: USERNAME, team_id: TEAM_ID, app_identifier: APP_ID, app_version: "1.0",
      skip_binary_upload: true, skip_screenshots: true, skip_metadata: true,
      submit_for_review: true, automatic_release: true, force: true,
      run_precheck_before_submit: false, precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end

platform :ios do
  desc "Dump what App Store Connect actually has for this app"
  lane :debug do
    connect_login
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.message("app id #{app.id} primary_locale=#{app.primary_locale}")
    app.get_app_store_versions(includes: "appStoreVersionLocalizations").each do |v|
      UI.message("version #{v.version_string} platform=#{v.platform} state=#{v.app_store_state} id=#{v.id}")
      (v.app_store_version_localizations || []).each do |l|
        UI.message("  loc #{l.locale}: desc=#{(l.description || '').length} chars, keywords=#{(l.keywords || '').length}")
        sets = Spaceship::ConnectAPI::AppScreenshotSet.all(app_store_version_localization_id: l.id)
        sets.each { |s| UI.message("    screenshots #{s.screenshot_display_type}: #{s.app_screenshots.count}") }
      end
    end
    infos = app.get_app_infos
    infos.each { |i| UI.message("appInfo #{i.id} state=#{i.app_store_state} ") }
  end
end

platform :ios do
  desc "Set price to Free (USA base territory) and make the app available in all territories"
  lane :pricing do
    connect_login
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    rc = Spaceship::ConnectAPI.client.tunes_request_client

    points = rc.get("v1/apps/#{app.id}/appPricePoints", { "filter[territory]" => "USA", "limit" => 200 }).body["data"]
    free = points.find { |pt| pt["attributes"]["customerPrice"].to_f == 0.0 }
    UI.user_error!("No free price point found") unless free
    UI.message("free price point #{free['id']}")

    body = { data: { type: "appPriceSchedules",
                     relationships: { app: { data: { type: "apps", id: app.id } },
                                      baseTerritory: { data: { type: "territories", id: "USA" } },
                                      manualPrices: { data: [{ type: "appPrices", id: "${price-free}" }] } } },
             included: [{ type: "appPrices", id: "${price-free}", attributes: { startDate: nil },
                          relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } } }] }
    rc.post("v1/appPriceSchedules", body)
    UI.success("Price schedule set to Free")

    territories = rc.get("v1/territories", { "limit" => 200 }).body["data"].map { |t| t["id"] }
    UI.message("#{territories.count} territories")
    begin
      existing = rc.get("v2/appAvailabilities/#{app.id}", { "include" => "territoryAvailabilities", "limit[territoryAvailabilities]" => 1 }).body
      UI.message("availability already exists: #{existing['data']['id']}")
    rescue => e
      UI.message("no availability yet (#{e.class}), creating")
      inc = territories.each_with_index.map do |t, i|
        { type: "territoryAvailabilities", id: "${t#{i}}", attributes: { available: true },
          relationships: { territory: { data: { type: "territories", id: t } } } }
      end
      body = { data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true },
                       relationships: { app: { data: { type: "apps", id: app.id } },
                                        territoryAvailabilities: { data: inc.map { |x| { type: "territoryAvailabilities", id: x[:id] } } } } },
               included: inc }
      rc.post("v2/appAvailabilities", body)
      UI.success("Available in #{territories.count} territories")
    end
  end
end
